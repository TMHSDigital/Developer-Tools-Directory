{
  "name": "{{ slug }}",
  "displayName": {{ name|json_str }},
  "description": {{ description|json_str }},
  "version": "0.1.0",
  "author": {
    "name": {{ author_name|json_str }},
    "email": {{ author_email|json_str }}
  },
  "license": "{{ license_spdx }}",
  "keywords": [
    "cursor-plugin",
    "developer-tools"{% if has_mcp %},
    "mcp"{% endif +%}
  ],
  "skills": [
{% for skill in skills %}
    "skills/{{ skill }}/SKILL.md"{% if not loop.last %},{% endif %}

{% endfor %}
  ],
  "rules": [
{% for rule in rules %}
    "rules/{{ rule }}.mdc"{% if not loop.last %},{% endif %}

{% endfor %}
  ]
}
